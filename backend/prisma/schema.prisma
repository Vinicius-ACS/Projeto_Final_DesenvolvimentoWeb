generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Produto {
  id         Int      @id @default(autoincrement())
  nome       String
  categoria  String
  quantidade Int
  preco      Float
  descricao  String?
  createdAt  DateTime @default(now())
}