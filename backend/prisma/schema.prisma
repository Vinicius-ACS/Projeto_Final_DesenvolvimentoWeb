generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use DATABASE_URL (Postgres) in production; fallback to SQLite for simple local dev
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoMov {
  ENTRADA
  SAIDA
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())

  movimentacoes Movimentacao[]
}

model Produto {
  id         Int      @id @default(autoincrement())
  sku        String?  @unique
  nome       String
  categoria  String
  quantidade Int      @default(0)
  preco      Float
  descricao  String?
  fornecedor String?
  localizacao String?
  minimo     Int      @default(0)
  createdAt  DateTime @default(now())

  movimentacoes Movimentacao[]
}

model Movimentacao {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  tipo       TipoMov
  quantidade Int
  descricao  String?
  createdAt  DateTime @default(now())
}
